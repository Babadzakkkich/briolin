# =========== POSTGRES (для Docker) ===========
POSTGRES_USER=search_user
POSTGRES_PASSWORD=search_password
POSTGRES_DB=search_db

# =========== SHARED ===========
SHARED__JWT_SECRET=skibidi
SHARED__JWT_ALGORITHM=HS256
SHARED__JWT_ISSUER=briolin-api-gateway
SHARED__JWT_AUDIENCE=briolin-services
SHARED__JWT_EXPIRE_MINUTES=5

# =========== RABBITMQ ===========
RABBITMQ__HOST=rabbitmq
RABBITMQ__PORT=5672
RABBITMQ__USER=guest
RABBITMQ__PASSWORD=guest
RABBITMQ__VHOST=/

# =========== KEYCLOAK ===========
KEYCLOAK__SERVER_URL=http://keycloak:8080/
KEYCLOAK__REALM=briolin

# =========== SEARCH SERVICE ===========
# Своя БД (для search_sessions) - НОВЫЕ ПЕРЕМЕННЫЕ
SEARCH__OWN_DB__USER=search_user
SEARCH__OWN_DB__PASSWORD=search_password
SEARCH__OWN_DB__HOST=search-postgres
SEARCH__OWN_DB__PORT=5432
SEARCH__OWN_DB__NAME=search_db

# БД profile-service (только чтение) - НОВЫЕ ПЕРЕМЕННЫЕ
SEARCH__PROFILE_DB__USER=profile_user
SEARCH__PROFILE_DB__PASSWORD=profile_password
SEARCH__PROFILE_DB__HOST=profile-postgres
SEARCH__PROFILE_DB__PORT=5432
SEARCH__PROFILE_DB__NAME=profile_db

# Auth service
SEARCH__AUTH_SERVICE__URL=http://auth-service:8001

# Общие настройки
SEARCH__DEBUG=True
SEARCH__SERVICE_NAME=search-service