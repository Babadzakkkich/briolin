# =========== SHARED ===========
SHARED__JWT_SECRET=skibidi
SHARED__JWT_ALGORITHM=HS256
SHARED__JWT_ISSUER=briolin-api-gateway
SHARED__JWT_AUDIENCE=briolin-services
SHARED__JWT_EXPIRE_MINUTES=5

# =========== RABBITMQ ===========
RABBITMQ__HOST=rabbitmq
RABBITMQ__PORT=5672
RABBITMQ__USER=guest
RABBITMQ__PASSWORD=guest
RABBITMQ__VHOST=/

# =========== KEYCLOAK ===========
# Gateway использует этот URL только для загрузки JWKS публичных ключей realm.
# Отдельный GATEWAY__KEYCLOAK__CLIENT_ID/CLIENT_SECRET для проверки access token больше не нужен.
KEYCLOAK__SERVER_URL=http://keycloak:8080/
KEYCLOAK__REALM=briolin

# =========== CACHE ===========
CACHE__REDIS_URL=redis://redis:6379/0
CACHE__USER_CACHE_TTL=60
CACHE__TOKEN_CACHE_TTL_BUFFER=30

# =========== SERVICES ===========
SERVICES__AUTH=http://auth-service:8001
SERVICES__USER=http://user-service:8002
SERVICES__PROFILE=http://profile-service:8003
SERVICES__TESTING=http://testing-service:8004
SERVICES__CHAT=http://chat-service:8005
SERVICES__CHAT_WS=ws://chat-service:8005
SERVICES__MATCHING=http://matching-service:8006
SERVICES__MEDIA=http://media-service:8007

# =========== API GATEWAY ===========
GATEWAY__HOST=0.0.0.0
GATEWAY__PORT=8000
GATEWAY__DEBUG=True
GATEWAY__SERVICE_NAME=api-gateway

# =========== COOKIE AUTH ===========
# Адреса frontend через запятую. При cookie-авторизации нельзя использовать CORS origin '*' вместе с credentials.
GATEWAY__CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Локально по HTTP: SECURE=False + SAMESITE=lax.
# На проде с HTTPS: SECURE=True. Для cross-site cookie: SAMESITE=none + SECURE=True.
GATEWAY__COOKIE__ACCESS_COOKIE_NAME=briolin_access_token
GATEWAY__COOKIE__REFRESH_COOKIE_NAME=briolin_refresh_token
GATEWAY__COOKIE__PATH=/
GATEWAY__COOKIE__DOMAIN=
GATEWAY__COOKIE__SECURE=False
GATEWAY__COOKIE__SAMESITE=lax
